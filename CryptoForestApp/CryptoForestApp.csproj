<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Crypto Forest App</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>ch.silvanbauer.CryptoForestApp</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Silvan Bauer</ApplicationPublisher>
    <!-- Package Description -->
    <Description>CryptoForestApp powered by Uno Platform.</Description>

    <!--
      UnoFeatures let's you quickly add and manage implicit package references based on the features you want to use.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
        Navigation;
        Hosting;
        MVUX;
        Configuration;
        Localization;
        SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

</Project>
