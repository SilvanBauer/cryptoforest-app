<ContentDialog
    x:Class="CryptoForestApp.Presentation.Dialogs.MoveContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CryptoForestApp.Presentation"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Daten verschieben"
    Style="{ThemeResource DefaultContentDialogStyle}"
    PrimaryButtonText="Verschieben"
    PrimaryButtonCommand="{Binding MoveAsync}"
    SecondaryButtonText="Abbrechen">
    <Grid>
        <ComboBox ItemsSource="{Binding Levels}" SelectedIndex="{Binding SelectedLevelIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Neue Ebene">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>
</ContentDialog>
