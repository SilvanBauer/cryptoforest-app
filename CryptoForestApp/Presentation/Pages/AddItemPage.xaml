<Page
    x:Class="CryptoForestApp.Presentation.Pages.AddItemPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CryptoForestApp.Presentation.Pages"
    xmlns:converters="using:CryptoForestApp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <converters:VisibilityConverter x:Key="VisibilityConverter" />
    </Page.Resources>
    <Grid Padding="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="5" Spacing="5">
            <TextBlock Text="Datentyp" />
            <StackPanel Orientation="Horizontal" Spacing="5">
                <RadioButton x:Uid="FilesRadioButton" IsChecked="{Binding IsFilesSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <RadioButton x:Uid="DirectoryRadioButton" IsChecked="{Binding IsDirectorySelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <RadioButton x:Uid="TextRadioButton" IsChecked="{Binding IsTextSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="5 5 5 8" Spacing="5" Visibility="{Binding IsFilesSelected, Converter={StaticResource VisibilityConverter}}">
            <TextBlock x:Uid="DataTextBlock" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding SelectedFiles}" VerticalAlignment="Center" />
                <Button x:Uid="SelectButton" Grid.Column="1" Width="150" Command="{Binding SelectFilesAsync}" />
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="5 5 5 8" Spacing="5" Visibility="{Binding IsDirectorySelected, Converter={StaticResource VisibilityConverter}}">
            <TextBlock x:Uid="DataTextBlock" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding SelectedDirectory}" VerticalAlignment="Center" />
                <Button x:Uid="SelectButton" Grid.Column="1" Width="150" Command="{Binding SelectDirectoryAsync}" />
            </Grid>
        </StackPanel>
        <TextBox x:Uid="DataTextBox" Grid.Row="1" Text="{Binding TextData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="5" Visibility="{Binding IsTextSelected, Converter={StaticResource VisibilityConverter}}" />

        <ComboBox x:Uid="LevelComboBox" Grid.Row="2" Margin="5" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedItem}" SelectedIndex="{Binding SelectedLevelIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <TextBox x:Uid="DataNameTextBox" Text="{Binding ItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="3" Margin="5" />

        <Button x:Uid="AddButton" Grid.Row="4" Margin="5" Width="150" VerticalAlignment="Bottom" Command="{Binding AddAsync}" />
        <Button x:Uid="BackButton" Grid.Row="4" Margin="5" Width="150" HorizontalAlignment="Right" VerticalAlignment="Bottom" Command="{Binding BackAsync}" />
    </Grid>
</Page>
