<Page
    x:Class="CryptoForestApp.Presentation.Pages.CryptoForestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:CryptoForestApp.Presentation.Pages"
    xmlns:converters="using:CryptoForestApp.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter" />
    </Page.Resources>
    <Grid Padding="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="auto" />
        </Grid.ColumnDefinitions>

        <Button Margin="5 5 0 5" Content="&lt;" />
        <Button Grid.Column="1" Margin="0 5 5 5" Content=">" />
        <TextBox x:Uid="SearchTextBox" Grid.Column="2" Margin="5" />
        <Button x:Uid="ResetButton" Grid.Column="3" Margin="5" Width="150" />

        <ListView Grid.Row="1" Grid.ColumnSpan="4" Margin="5" HorizontalAlignment="Center" ScrollViewer.VerticalScrollBarVisibility="Auto" SelectedItem="{Binding SelectedEntry, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Entries}">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="150">
                        <Image Margin="5" Source="{Binding Value, Converter={StaticResource ImagePathConverter}}" />
                        <TextBlock Margin="5" Text="{Binding Key}" HorizontalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <WrapPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal" >
            <Button x:Uid="AddButton" Margin="5" Width="150" Command="{Binding AddAsync}" />
            <Button x:Uid="DecryptButton" Margin="5" Width="150" Command="{Binding DecryptAsync}" />
            <Button x:Uid="DeleteButton" Margin="5" Width="150" Command="{Binding DeleteAsync}" />
            <Button x:Uid="MoveButton" Margin="5" Width="150" Command="{Binding MoveAsync}" />
            <Button x:Uid="AddLevelButton" Margin="5" Width="150" Command="{Binding AddLevelAsync}" />
            <Button x:Uid="ExportButton" Margin="5" Width="150" />
        </WrapPanel>
    </Grid>
</Page>
